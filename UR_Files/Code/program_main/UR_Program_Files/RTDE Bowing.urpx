 == 1"}}},"guid":"60c669d0-95c5-a32e-3fde-60cdb6779d72","parentId":"0f2191a8-5825-02b2-ff67-74045a73f079","programLabel":[{"type":"secondary","value":"force_enabled == 1"}]},{"children":[],"contributedNode":{"type":"ur-script","version":"0.0.1","parameters":{"name":"","expression":"sync()","valid":true}},"guid":"bf99e6b1-082f-2aac-0e8a-cc63ed54e563","parentId":"0f2191a8-5825-02b2-ff67-74045a73f079","programLabel":"sync()"}],"contributedNode":{"type":"ur-loop","version":"0.0.2","allowsChildren":true,"parameters":{"type":"always","expression":{"value":"","selectedType":"EXPRESSION"},"xtimes":1}},"guid":"0f2191a8-5825-02b2-ff67-74045a73f079","parentId":"2c8b0f11-6b79-f360-7e71-65e92e3bf190","programLabel":[{"type":"secondary","translationKey":"program-node-label.loop.always"}]}],"contributedNode":{"type":"ur-loop","version":"0.0.2","allowsChildren":true,"parameters":{"type":"always","expression":{"value":"","selectedType":"EXPRESSION"},"xtimes":1}},"guid":"2c8b0f11-6b79-f360-7e71-65e92e3bf190","parentId":"f48465f4-fcc9-801c-fd99-694c6240d3a4","programLabel":[{"type":"secondary","translationKey":"program-node-label.loop.always"}]}],"contributedNode":{"type":"ur-code","version":"0.0.1","allowsChildren":true,"lockChildren":false,"parameters":{"loopForever":true}},"guid":"f48465f4-fcc9-801c-fd99-694c6240d3a4","parentId":"503fa9f3-b642-3793-71d3-a89bca486cac","programLabel":[{"type":"secondary","translationKey":"program-node-label.code.looping"},{"type":"secondary","translationKey":"program-node-label.code.enabled"}]}]},"programInformation":{"name":"RTDE Bowing","description":null,"createdDate":1786411240131,"lastSavedDate":null,"lastModifiedDate":1786899542670,"programState":"DRAFT","functionsBlockShown":false},"urscript":{"script":"$ 1 \"ur-program\"\n$ 2 \"ur-modules\"\n$ 3 \"ur-functions\"\n$ 4 \"ur-function\"\nthread rtde_get_pos():\n  while (True):\n    $ 5 \"ur-script\"\n    pose_setp = p[\n        read_input_float_register(0),\n        read_input_float_register(1),\n        read_input_float_register(2),\n        read_input_float_register(3),\n        read_input_float_register(4),\n        read_input_float_register(5)\n    ]\n    $ 6 \"ur-assignment\"\n    velocity = read_input_float_register(6)\n    $ 7 \"ur-assignment\"\n    acceleration = read_input_float_register(7)\n    $ 8 \"ur-assignment\"\n    global dt = read_input_float_register(8)\n    $ 9 \"ur-assignment\"\n    global lookahead_time = read_input_float_register(9)\n    $ 10 \"ur-assignment\"\n    global gain = read_input_float_register(10)\n    $ 11 \"ur-loop\"\n    while (True):\n      $ 12 \"ur-assignment\"\n      global tmp = [0,0,0,0,0,0]\n      $ 13 \"ur-script\"\n      tmp[0]=read_input_float_register(0)\r\n      tmp[1]=read_input_float_register(1)\r\n      tmp[2]=read_input_float_register(2)\r\n      tmp[3]=read_input_float_register(3)\r\n      tmp[4]=read_input_float_register(4)\r\n      tmp[5]=read_input_float_register(5)\n      $ 14 \"ur-assignment\"\n      joint_setp = tmp\n      $ 15 \"ur-script\"\n      pose_setp = p[\n          tmp[0],\n          tmp[1],\n          tmp[2],\n          tmp[3],\n          tmp[4],\n          tmp[5]\n      ]\n      $ 16 \"ur-if\"\n      if (not( tmp ==[0,0,0,0,0,0])):\n        $ 17 \"ur-assignment\"\n        joint_setp = tmp\n        $ 18 \"ur-script\"\n        pose_setp = p[\n            tmp[0],\n            tmp[1],\n            tmp[2],\n            tmp[3],\n            tmp[4],\n            tmp[5]\n        ]\n      end\n      $ 19 \"ur-script\"\n      # Force Task Frame\n      task_frame = p[\n          read_input_float_register(12),\n          read_input_float_register(13),\n          read_input_float_register(14),\n          read_input_float_register(15),\n          read_input_float_register(16),\n          read_input_float_register(17)\n      ]\n      # Force Selection Vector\n      selection_vector = [\n          read_input_float_register(18),\n          read_input_float_register(19),\n          read_input_float_register(20),\n          read_input_float_register(21),\n          read_input_float_register(22),\n          read_input_float_register(23)\n      ]\n      # Force Wrench\n      wrench = [\n          read_input_float_register(24),\n          read_input_float_register(25),\n          read_input_float_register(26),\n          read_input_float_register(27),\n          read_input_float_register(28),\n          read_input_float_register(29)\n      ]\n      # Force Limits\n      limits = [\n          read_input_float_register(30),\n          read_input_float_register(31),\n          read_input_float_register(32),\n          read_input_float_register(33),\n          read_input_float_register(34),\n          read_input_float_register(35)\n      ]\n      $ 20 \"ur-assignment\"\n      motion_mode = read_input_integer_register(0)\n      $ 21 \"ur-assignment\"\n      global force_enabled = read_input_integer_register(1)\n      $ 22 \"ur-assignment\"\n      global force_type = read_input_integer_register(2)\n      $ 23 \"ur-script\"\n      sync()\n    end\nend\nend\n$ 24 \"ur-before-start\"\n$ 25 \"ur-assignment\"\nglobal pose_setp = get_actual_tcp_pose()\n$ 26 \"ur-assignment\"\nglobal joint_setp = get_actual_joint_positions()\n$ 27 \"ur-assignment\"\nglobal task_frame = p[0,0,0,0,0,0]\n$ 28 \"ur-assignment\"\nglobal selection_vector = [0,0,0,0,0,0]\n$ 29 \"ur-assignment\"\nglobal wrench = [0,0,0,0,0,0]\n$ 30 \"ur-assignment\"\nglobal limits = [0,0,0,0,0,0]\n$ 31 \"ur-assignment\"\nforce_type = 2\n$ 32 \"ur-assignment\"\nforce_enabled = 0\n$ 33 \"ur-assignment\"\nglobal motion_mode = 0\n$ 34 \"ur-assignment\"\nglobal acceleration = 0\n$ 35 \"ur-assignment\"\nglobal velocity = 0\n$ 36 \"ur-script\"\nrtde_set_watchdog(\"input_int_register_0\",10,\"pause\")\n$ 37 \"ur-code\"\nwhile (True):\n  $ 38 \"ur-assignment\"\n  global previous_motion_mode = 0\n  $ 39 \"ur-assignment\"\n  global previous_force_enabled = 0\n  $ 40 \"ur-loop\"\n  while (True):\n    $ 41 \"ur-thread\"\n    rtde_get_pos_handler = run rtde_get_pos()\n    $ 42 \"ur-script\"\n    write_output_integer_register(0,0)\n    sync()\n    $ 43 \"ur-loop\"\n    while (True):\n      $ 44 \"ur-if\"\n      if (motion_mode != previous_motion_mode ):\n        $ 45 \"ur-if\"\n        if (motion_mode == 1):\n          $ 46 \"ur-script\"\n          write_output_integer_register(0,1)\n          $ 47 \"ur-script\"\n          movel(\n              pose_setp,\n              acceleration,\n              velocity\n          )\n          $ 48 \"ur-script\"\n          write_output_integer_register(0,0)\n        $ 49 \"ur-elseif\"\n        elif (motion_mode == 2):\n          $ 50 \"ur-script\"\n          write_output_integer_register(0,1)\n          $ 51 \"ur-script\"\n          movej(\n              joint_setp,\n              acceleration,\n              velocity\n          )\n          $ 52 \"ur-script\"\n          write_output_integer_register(0,0)\n        $ 53 \"ur-elseif\"\n        elif (motion_mode == 0):\n          $ 54 \"ur-script\"\n          sync()\n        end\n        $ 55 \"ur-assignment\"\n        previous_motion_mode = motion_mode\n      end\n      $ 56 \"ur-if\"\n      if (motion_mode == 3):\n        $ 57 \"ur-script\"\n        write_output_integer_register(0,1)\n        $ 58 \"ur-script\"\n        servoj(\n            joint_setp,\n            acceleration,\n            velocity,\n            dt,\n            lookahead_time,\n            gain\n        )\n        $ 59 \"ur-script\"\n        write_output_integer_register(0,0)\n      end\n      $ 60 \"ur-if\"\n      if (force_enabled == 1):\n        $ 61 \"ur-script\"\n        force_mode(\n            task_frame,\n            selection_vector,\n            wrench,\n            force_type,\n            limits\n        )\n      end\n      $ 62 \"ur-script\"\n      sync()\n    end\n  end\nend","nodeIDList":["00000000-0000-0000-0000-000000000000","503fa9f3-b642-3793-71d3-a89bca486cac","42247264-1d53-8125-d3a1-d9fe79e1da75","aade040d-e866-9c4c-f21a-9